+		// princeofpersia remake: the golden record of the prince's physics
+		// and of the tile mechanisms (tools/matchphysics.mjs). One JSON line
+		// per game frame when the environment variable POP_TRACE names a file.
+		{
+			static FILE* pop_trace_fp = NULL;
+			static int pop_trace_checked = 0;
+			if (!pop_trace_checked) {
+				pop_trace_checked = 1;
+				const char* pop_trace_name = getenv("POP_TRACE");
+				if (pop_trace_name != NULL) pop_trace_fp = fopen(pop_trace_name, "w");
+			}
+			if (pop_trace_fp != NULL) {
+				int pop_t;
+				fprintf(pop_trace_fp,
+					"{\"x\":%d,\"y\":%d,\"shift\":%d,\"kid\":{\"level\":%d,\"room\":%d,\"x\":%d,\"y\":%d,\"frame\":%d,\"row\":%d,\"col\":%d,\"direction\":%d,\"action\":%d,\"seq\":%d,\"hp\":%d,\"drawnRoom\":%d,\"min\":%d,\"tick\":%d,\"trobs\":%d,\"mobs\":%d,\"door\":%d,\"tiles\":[",
+					(int)control_x, (int)control_y, control_shift == CONTROL_HELD ? 1 : 0,
+					(int)current_level, (int)Kid.room, (int)Kid.x, (int)Kid.y, (int)Kid.frame, (int)Kid.curr_row, (int)Kid.curr_col,
+					(int)Kid.direction, (int)Kid.action, (int)Kid.curr_seq, (int)hitp_curr, (int)drawn_room,
+					(int)rem_min, (int)rem_tick, (int)trobs_count, (int)mobs_count, (int)leveldoor_open);
+				// the tile types and modifiers of the prince's room (30 zeros for room 0)
+				for (pop_t = 0; pop_t < 30; ++pop_t)
+					fprintf(pop_trace_fp, "%s%d", pop_t ? "," : "", Kid.room ? level.fg[(Kid.room - 1) * 30 + pop_t] & 0x1F : 0);
+				fprintf(pop_trace_fp, "],\"mods\":[");
+				for (pop_t = 0; pop_t < 30; ++pop_t)
+					fprintf(pop_trace_fp, "%s%d", pop_t ? "," : "", Kid.room ? level.bg[(Kid.room - 1) * 30 + pop_t] : 0);
+				fprintf(pop_trace_fp, "]}}\n");
+				fflush(pop_trace_fp);
+			}
+		}
